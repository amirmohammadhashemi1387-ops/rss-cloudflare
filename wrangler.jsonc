{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rss-bridge",
  "main": "workers/index.ts",
  "compatibility_date": "2026-02-10",
  "workers_dev": true,
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "شناسه_KV_شما_اینجا"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rss-reader",
      "database_id": "شناسه_D1_شما_اینجا"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "RSSReaderMCP", "class_name": "RSSReaderMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RSSReaderMCP"] }],
  "vars": {
    // مقادیر پیش‌فرض پروژه (می‌توانید تغییر دهید)
    "USER_ID_CACHE_TTL": "86400",
    "FEED_CACHE_TTL": "900"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "queues": {
    "producers": [
      { "binding": "FEED_FETCH_QUEUE", "queue": "rss-bot-fetch-queue" },
      { "binding": "TELEGRAM_SEND_QUEUE", "queue": "rss-bot-send-queue" }
    ]
  }
}
